#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RUNNER="$SCRIPT_DIR/hermes_fleet_migrate.py"

if [[ ! -f "$RUNNER" ]]; then
  echo "ERROR: migration runner is missing: $RUNNER" >&2
  exit 3
fi

candidates=()
if [[ -n "${HERMES_PYTHON:-}" ]]; then
  candidates+=("$HERMES_PYTHON")
fi
candidates+=("python3")

if command -v hermes >/dev/null 2>&1; then
  hermes_path="$(command -v hermes)"
  if resolved="$(readlink -f "$hermes_path" 2>/dev/null)"; then
    shebang="$(head -n 1 "$resolved" 2>/dev/null || true)"
    if [[ "$shebang" == '#!'*python* ]]; then
      interpreter="${shebang#\#!}"
      interpreter="${interpreter%% *}"
      candidates=("$interpreter" "${candidates[@]}")
    fi
  fi
fi

for candidate in "${candidates[@]}"; do
  if command -v "$candidate" >/dev/null 2>&1 || [[ -x "$candidate" ]]; then
    exec "$candidate" "$RUNNER" "$@"
  fi
done

echo "ERROR: no usable Python interpreter found for migration runner" >&2
exit 3
